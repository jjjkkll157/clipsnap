{
  "manifest_version": 3,
  "name": "ClipSnap - 网页一键转 Markdown",
  "version": "1.0.1",
  "description": "点击一下，把任何网页变成干净的 Markdown。支持微信公众号、知乎、CSDN 等平台的智能内容提取。",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:8710/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipSnap",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  }
}
